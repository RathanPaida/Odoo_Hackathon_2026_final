    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.0.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "16.3.4",
    "nodemailer": "^9.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
