// prisma/schema/approvals.prisma
// PERSON 2 OWNED: Catalog, Discount Governance, Approvals, Warehouse, Fulfillment

// ─── Catalog ──────────────────────────────────────────────────────────────────

model Category {
  id                    String                 @id @default(uuid())
  name                  String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  products              Product[]
  categoryDiscountRules CategoryDiscountRule[]
}

model Product {
  id              String           @id @default(uuid())
  name            String
  description     String?
  categoryId      String
  productType     ProductType      @default(ONE_TIME)
  basePrice       Decimal          @db.Decimal(12, 2)
  costPrice       Decimal          @db.Decimal(12, 2)
  taxRate         Decimal          @default(0.00) @db.Decimal(5, 2)
  minimumMargin   Decimal          @default(0.00) @db.Decimal(5, 2)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  category        Category         @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  warehouseStocks WarehouseStock[]
  quotationLines  QuotationLine[]
  orderLines      OrderLine[]
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String
  attributeName  String
  attributeValue String
  extraPrice     Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Discount Governance & Blended Risk Engine ───────────────────────────────

model DiscountTier {
  id              String       @id @default(uuid())
  customerTier    CustomerTier
  maximumDiscount Decimal      @db.Decimal(5, 2)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([customerTier])
}

model CategoryDiscountRule {
  id              String   @id @default(uuid())
  categoryId      String
  maximumDiscount Decimal  @db.Decimal(5, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        Category @relation(fields: [categoryId], references: [id])
  @@unique([categoryId])
}

model ApprovalRule {
  id                    String        @id @default(uuid())
  minimumRiskScore      Decimal       @db.Decimal(5, 2)
  maximumRiskScore      Decimal       @db.Decimal(5, 2)
  requiredApprovalLevel ApprovalLevel
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

// ─── Approval Flow & Audit Trail ─────────────────────────────────────────────

model ApprovalRequest {
  id           String          @id @default(uuid())
  quotationId  String
  level        ApprovalLevel
  status       ApprovalOutcome @default(PENDING_APPROVAL)
  assignedRole Role
  riskScore    Decimal         @default(0.00) @db.Decimal(5, 2)
  reason       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  actions      ApprovalAction[]
  @@index([quotationId])
}

model ApprovalAction {
  id                String             @id @default(uuid())
  approvalRequestId String
  actorId           String
  action            ApprovalActionType
  reason            String?
  timestamp         DateTime           @default(now())

  approvalRequest   ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  @@index([approvalRequestId])
}

// ─── Multi-Warehouse Fulfillment & Backorders ─────────────────────────────────

model Warehouse {
  id               String            @id @default(uuid())
  name             String
  latitude         Decimal           @db.Decimal(9, 6)
  longitude        Decimal           @db.Decimal(9, 6)
  shippingBaseCost Decimal           @db.Decimal(12, 2)
  priority         Int               @default(1)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  stocks           WarehouseStock[]
  fulfillmentLines FulfillmentLine[]
}

model WarehouseStock {
  id                String    @id @default(uuid())
  warehouseId       String
  productId         String
  availableQuantity Int       @default(0)
  reservedQuantity  Int       @default(0)
  reorderLevel      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  product           Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model Fulfillment {
  id                    String            @id @default(uuid())
  orderId               String
  status                String            @default("PENDING") // PENDING | PARTIALLY_FULFILLED | FULFILLED
  estimatedShippingCost Decimal           @default(0.00) @db.Decimal(12, 2)
  shipmentCount         Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  lines                 FulfillmentLine[]
  @@index([orderId])
}

model FulfillmentLine {
  id            String      @id @default(uuid())
  fulfillmentId String
  orderLineId   String
  warehouseId   String
  quantity      Int
  shippingCost  Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  warehouse     Warehouse   @relation(fields: [warehouseId], references: [id])
  @@index([fulfillmentId])
}

model Backorder {
  id          String   @id @default(uuid())
  orderLineId String
  quantity    Int
  status      String   @default("OPEN") // OPEN | ALLOCATED | CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderLineId])
}
