// prisma/schema.prisma
// Single source of truth — never invent a field name
// All monetary values are Decimal(12,2)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SALES_REP
  SALES_MANAGER
  FINANCE
  ADMIN
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NEGOTIATING
  CONFIRMED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AllocationStatus {
  RESERVED
  BACKORDERED
  SHIPPED
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum AnomalyKind {
  DEEP_DISCOUNT
  NEGATIVE_MARGIN
  EXCESSIVE_REAPPROVAL
}

enum UpsellKind {
  UPSELL
  CROSS_SELL
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  name             String
  role             Role
  approvalLimitPct Decimal        @db.Decimal(5, 2)
  emailVerified    Boolean        @default(false)
  createdAt        DateTime       @default(now())

  refreshTokens    RefreshToken[]
  quotes           Quote[]        @relation("QuoteOwner")
  approvals        Approval[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}


model Customer {
  id     String       @id @default(cuid())
  name   String
  email  String       @unique
  tier   CustomerTier

  quotes Quote[]
}

model Product {
  id          String      @id @default(cuid())
  sku         String      @unique
  name        String
  category    String
  listPrice   Decimal     @db.Decimal(12, 2)
  unitCost    Decimal     @db.Decimal(12, 2)
  billingType BillingType

  priceListItems  PriceListItem[]
  quoteLines      QuoteLine[]
  stockItems      Stock[]
  upsellTriggered UpsellRule[]    @relation("UpsellTrigger")
  upsellRecommend UpsellRule[]    @relation("UpsellRecommend")
}

model PriceList {
  id       String          @id @default(cuid())
  name     String
  currency String          @default("USD")

  items    PriceListItem[]
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  productId   String
  price       Decimal   @db.Decimal(12, 2)

  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
}

model DiscountRule {
  id                 String   @id @default(cuid())
  customerTier       CustomerTier
  productCategory    String
  maxAutoApprovePct  Decimal  @db.Decimal(5, 2)
  requiredRole       Role

  @@unique([customerTier, productCategory])
}

model Quote {
  id                 String      @id @default(cuid())
  quoteNumber        String      @unique
  customerId         String
  ownerId            String
  status             QuoteStatus
  subtotal           Decimal     @db.Decimal(12, 2) @default(0)
  discountTotal      Decimal     @db.Decimal(12, 2) @default(0)
  taxTotal           Decimal     @db.Decimal(12, 2) @default(0)
  grandTotal         Decimal     @db.Decimal(12, 2) @default(0)
  blendedDiscountPct Decimal     @db.Decimal(5, 2)  @default(0)
  marginPct          Decimal     @db.Decimal(5, 2)  @default(0)
  reapprovalCount    Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  customer    Customer    @relation(fields: [customerId], references: [id])
  owner       User        @relation("QuoteOwner", fields: [ownerId], references: [id])
  lines       QuoteLine[]
  approvals   Approval[]
  invoice     Invoice?
  anomalies   Anomaly[]
  portalTokens PortalToken[]

  @@index([status])
}

model QuoteLine {
  id                String      @id @default(cuid())
  quoteId           String
  productId         String
  qty               Int
  unitPrice         Decimal     @db.Decimal(12, 2)
  discountPct       Decimal     @db.Decimal(5, 2)
  lineTotal         Decimal     @db.Decimal(12, 2)
  billingType       BillingType
  subscriptionMonths Int?

  quote             Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  allocations       Allocation[]
  subscriptionLine  SubscriptionLine?

  @@index([quoteId])
}

model Approval {
  id           String         @id @default(cuid())
  quoteId      String
  approverId   String?
  requiredRole Role
  status       ApprovalStatus
  reason       String?
  decidedAt    DateTime?
  cycle        Int
  createdAt    DateTime       @default(now())

  quote        Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  approver     User?          @relation(fields: [approverId], references: [id])

  @@index([quoteId])
}

model Warehouse {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  region      String

  stockItems  Stock[]
  allocations Allocation[]
}

model Stock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  qtyOnHand   Int
  version     Int       @default(0)

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model Allocation {
  id          String           @id @default(cuid())
  quoteLineId String
  warehouseId String?
  qty         Int
  status      AllocationStatus
  createdAt   DateTime         @default(now())

  quoteLine   QuoteLine        @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id])

  @@index([quoteLineId])
}

model Invoice {
  id            String    @id @default(cuid())
  quoteId       String    @unique
  invoiceNumber String    @unique
  amount        Decimal   @db.Decimal(12, 2)
  issuedAt      DateTime  @default(now())
  dueAt         DateTime

  quote         Quote     @relation(fields: [quoteId], references: [id])
  subscriptions SubscriptionLine[]
}

model SubscriptionLine {
  id                   String    @id @default(cuid())
  quoteLineId          String    @unique
  invoiceId            String?
  monthlyAmount        Decimal   @db.Decimal(12, 2)
  startDate            DateTime
  months               Int
  proratedFirstAmount  Decimal   @db.Decimal(12, 2)

  quoteLine            QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  invoice              Invoice?  @relation(fields: [invoiceId], references: [id])
}

model UpsellRule {
  id                  String     @id @default(cuid())
  triggerProductId    String?
  triggerCategory     String?
  recommendedProductId String
  kind                UpsellKind
  priority            Int

  triggerProduct      Product?   @relation("UpsellTrigger", fields: [triggerProductId], references: [id])
  recommendedProduct  Product    @relation("UpsellRecommend", fields: [recommendedProductId], references: [id])
}

model PortalToken {
  id        String    @id @default(cuid())
  quoteId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  // Append-only. Never update or delete rows in this table.
  @@index([entityType, entityId])
}

model Anomaly {
  id         String      @id @default(cuid())
  quoteId    String
  kind       AnomalyKind
  detail     String
  detectedAt DateTime    @default(now())

  quote      Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}
