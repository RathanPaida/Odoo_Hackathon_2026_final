// prisma/schema.prisma
// Single source of truth ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â never invent a field name
// All monetary values are Decimal(12,2)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

