enum Role {
  SALES_REP
  SALES_MANAGER
  FINANCE
  ADMIN
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NEGOTIATING
  CONFIRMED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AllocationStatus {
  RESERVED
  BACKORDERED
  SHIPPED
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum AnomalyKind {
  DEEP_DISCOUNT
  NEGATIVE_MARGIN
  EXCESSIVE_REAPPROVAL
}

enum OrderStatus {
  CONFIRMED
  FULFILLING
  PARTIALLY_FULFILLED
  FULFILLED
  BILLING_PENDING
  COMPLETED
  CANCELLED
}

enum UpsellKind {
  UPSELL
  CROSS_SELL
}

// ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ Models ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  name             String
  role             Role
  approvalLimitPct Decimal        @db.Decimal(5, 2)
  emailVerified    Boolean        @default(false)
  createdAt        DateTime       @default(now())

  refreshTokens    RefreshToken[]
  quotes           Quote[]        @relation("QuoteOwner")
  approvals        Approval[]
  negotiationComments NegotiationComment[] @relation("NegotiationActor")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}


model Customer {
  id          String       @id @default(cuid())
  companyName String
  contactName String
  email       String       @unique
  phone       String?
  tier        CustomerTier
  currency    String       @default("INR")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  quotes Quote[]
  orders Order[]
  negotiationComments NegotiationComment[]
}

model Product {
  id             String      @id @default(cuid())
  sku            String      @unique
  name           String
  category       String
  listPrice      Decimal     @db.Decimal(12, 2)
  unitCost       Decimal     @db.Decimal(12, 2)
  taxRate        Decimal     @db.Decimal(5, 2) @default(18)
  minimumMargin  Decimal     @db.Decimal(5, 2) @default(10)
  billingType    BillingType

  priceListItems  PriceListItem[]
  quoteLines      QuoteLine[]
  stockItems      Stock[]
  orderLines      OrderLine[]
  upsellTriggered UpsellRule[]    @relation("UpsellTrigger")
  upsellRecommend UpsellRule[]    @relation("UpsellRecommend")
}

model PriceList {
  id       String          @id @default(cuid())
  name     String
  currency String          @default("USD")

  items    PriceListItem[]
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  productId   String
  price       Decimal   @db.Decimal(12, 2)

  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
}

model DiscountRule {
  id                 String   @id @default(cuid())
  customerTier       CustomerTier
  productCategory    String
  maxAutoApprovePct  Decimal  @db.Decimal(5, 2)
  requiredRole       Role

  @@unique([customerTier, productCategory])
}

model Quote {
  id                 String      @id @default(cuid())
  quoteNumber        String      @unique
  customerId         String
  ownerId            String
  status             QuoteStatus
  currency           String      @default("INR")
  subtotal           Decimal     @db.Decimal(12, 2) @default(0)
  discountTotal      Decimal     @db.Decimal(12, 2) @default(0)
  taxTotal           Decimal     @db.Decimal(12, 2) @default(0)
  grandTotal         Decimal     @db.Decimal(12, 2) @default(0)
  totalCost          Decimal     @db.Decimal(12, 2) @default(0)
  marginAmount       Decimal     @db.Decimal(12, 2) @default(0)
  blendedDiscountPct Decimal     @db.Decimal(5, 2)  @default(0)
  marginPct          Decimal     @db.Decimal(5, 2)  @default(0)
  riskScore          Decimal     @db.Decimal(5, 2)  @default(0)
  reapprovalCount    Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  lastActivityAt     DateTime    @default(now())

  customer    Customer    @relation(fields: [customerId], references: [id])
  owner       User        @relation("QuoteOwner", fields: [ownerId], references: [id])
  lines       QuoteLine[]
  approvals   Approval[]
  invoice     Invoice?
  anomalies   Anomaly[]
  portalTokens PortalToken[]
  orders       Order[]
  negotiationComments NegotiationComment[]

  @@index([status])
  @@index([ownerId])
  @@index([customerId])
}

model QuoteLine {
  id                String      @id @default(cuid())
  quoteId           String
  productId         String
  qty               Int
  unitPrice         Decimal     @db.Decimal(12, 2)
  discountPct       Decimal     @db.Decimal(5, 2)
  lineTotal         Decimal     @db.Decimal(12, 2)
  billingType       BillingType
  subscriptionMonths Int?

  quote             Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
  allocations       Allocation[]
  subscriptionLine  SubscriptionLine?

  @@index([quoteId])
}

model Approval {
  id           String         @id @default(cuid())
  quoteId      String
  approverId   String?
  requiredRole Role
  status       ApprovalStatus
  reason       String?
  decidedAt    DateTime?
  cycle        Int
  createdAt    DateTime       @default(now())

  quote        Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  approver     User?          @relation(fields: [approverId], references: [id])

  @@index([quoteId])
}

model Warehouse {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  region      String

  stockItems  Stock[]
  allocations Allocation[]
}

model Stock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  qtyOnHand   Int
  version     Int       @default(0)

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
}

model Allocation {
  id          String           @id @default(cuid())
  quoteLineId String
  warehouseId String?
  qty         Int
  status      AllocationStatus
  createdAt   DateTime         @default(now())

  quoteLine   QuoteLine        @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id])

  @@index([quoteLineId])
}

model Invoice {
  id            String    @id @default(cuid())
  quoteId       String    @unique
  invoiceNumber String    @unique
  amount        Decimal   @db.Decimal(12, 2)
  issuedAt      DateTime  @default(now())
  dueAt         DateTime

  quote         Quote     @relation(fields: [quoteId], references: [id])
  subscriptions SubscriptionLine[]
}

model SubscriptionLine {
  id                   String    @id @default(cuid())
  quoteLineId          String    @unique
  invoiceId            String?
  monthlyAmount        Decimal   @db.Decimal(12, 2)
  startDate            DateTime
  months               Int
  proratedFirstAmount  Decimal   @db.Decimal(12, 2)

  quoteLine            QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  invoice              Invoice?  @relation(fields: [invoiceId], references: [id])
}

model UpsellRule {
  id                  String     @id @default(cuid())
  triggerProductId    String?
  triggerCategory     String?
  recommendedProductId String
  kind                UpsellKind
  priority            Int

  triggerProduct      Product?   @relation("UpsellTrigger", fields: [triggerProductId], references: [id])
  recommendedProduct  Product    @relation("UpsellRecommend", fields: [recommendedProductId], references: [id])
}

model PortalToken {
  id        String    @id @default(cuid())
  quoteId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  // Append-only. Never update or delete rows in this table.
  @@index([entityType, entityId])
}

model Anomaly {
  id         String      @id @default(cuid())
  quoteId    String
  kind       AnomalyKind
  detail     String
  detectedAt DateTime    @default(now())

  quote      Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ Person 1: Sales Models ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  quotationId  String
  customerId   String
  status       OrderStatus @default(CONFIRMED)
  subtotal     Decimal     @db.Decimal(12, 2)
  taxAmount    Decimal     @db.Decimal(12, 2)
  totalAmount  Decimal     @db.Decimal(12, 2)
  currency     String      @default("INR")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  quotation    Quote       @relation(fields: [quotationId], references: [id])
  customer     Customer    @relation(fields: [customerId], references: [id])
  lines        OrderLine[]

  @@index([customerId])
  @@index([quotationId])
}

model OrderLine {
  id                 String      @id @default(cuid())
  orderId            String
  productId          String
  quantity           Int
  unitPrice          Decimal     @db.Decimal(12, 2)
  taxAmount          Decimal     @db.Decimal(12, 2) @default(0)
  totalAmount        Decimal     @db.Decimal(12, 2)
  productType        BillingType
  subscriptionPlanId String?     // plain nullable string, no FK ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â resolved by Person 3

  order              Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product     @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model NegotiationComment {
  id          String   @id @default(cuid())
  quoteId     String
  customerId  String?
  actorId     String?  // null if customer, set if internal user
  lineId      String?  // null = quote-level, set = specific line
  content     String
  commentType String   @default("COMMENT") // COMMENT | COUNTER_DISCOUNT | QTY_CHANGE | PRODUCT_CHANGE
  metadata    Json?    // e.g. { requestedDiscount: 15, requestedQty: 10 }
  createdAt   DateTime @default(now())

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id])
  actor       User?    @relation("NegotiationActor", fields: [actorId], references: [id])

  @@index([quoteId])
}

