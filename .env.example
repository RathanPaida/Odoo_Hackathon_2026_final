# ─── .env.example ────────────────────────────────────────────────────────────
# Copy this file to .env and .env.local and fill in the values.
#
# .env       → used by Prisma CLI (migrate, seed, studio)
# .env.local → used by Next.js runtime
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required in BOTH .env and .env.local) ───────────────────────────
# Docker: postgresql://dealflow:dealflow@localhost:5432/dealflow
# Neon:   postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://dealflow:dealflow@localhost:5432/dealflow"

# ── Redis (only in .env.local) ────────────────────────────────────────────────
# Docker:  redis://localhost:6379
# Upstash: redis://default:xxxxx@us1-xxx.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# ── JWT Secrets (only in .env.local) — must be at least 32 characters ─────────
JWT_SECRET="replace-with-32-byte-random-string"
JWT_REFRESH_SECRET="replace-with-different-32-byte-string"
PORTAL_TOKEN_SECRET="replace-with-another-32-byte-string"

# ── Token TTLs (only in .env.local) ──────────────────────────────────────────
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"
